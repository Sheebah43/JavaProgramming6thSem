/* Program 2.10: Write a Java program that: 
Replaces all 0 with 1  
Replaces all 1 with 0  
Keeps other digits same  
Example: 
Input: 102301 
Output: 012310*/
import java.util.Scanner;
public class ReplaceZeroAndOne {
    public static void main(String[] args){
        String numString;
        System.out.print("Enter a number:\n");
        Scanner sc = new Scanner(System.in);
        numString = sc.nextLine();
        char num[] = numString.toCharArray();
        for(int i=0; i<num.length;i++){
            if(num[i]=='0'){
                num[i]='1';
            }
            else if(num[i]=='1'){
                num[i]='0';
            }
        }
        String newNum = new String(num);
        System.out.println("The number after replacing 0 with 1 and 1 with 0 is: " + newNum);

    }
    
}
