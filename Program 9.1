/*  Program 9.1: Creating Threads
Objective: Learn how to create and execute threads in Java.
Task: Write a Java program to create one thread by extending the Thread class and another by implementing the Runnable interface. 
Display numbers from 1 to 10 from each thread and print the name of the currently executing thread.
*/
public class CreatingThreads {
    public static class MyThreadByExtension extends Thread{
        public void run(){
            System.out.println("Running a thread by extending Thread class.");

            for(int i = 1; i<=10; i++){
                System.out.print(i+" ");
            }  
        }

    }
    public static class MyThreadByImplementation implements Runnable{
        public void run(){
            System.out.println("Running a thread by implementing Runnable interface.");

            for(int i=1; i<=10; i++){
                System.out.println(i+" ");
            }
        }
    }
    public static void main (String [] args){
        MyThreadByExtension t1 = new MyThreadByExtension();
        t1.start();
        MyThreadByImplementation t2 = new MyThreadByImplementation();
        Thread t = new Thread(t2);
        t.start();
    }
    
}
