/* Program 2.8: Write a Java program that counts how many digits of a number divide the 
number exactly. 
Example: 
Input: 124 
Digits: 1,2,4 
All divide 124 → count = 3*/
import java.util.Scanner;

public class DigitDivisors {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        int num = sc.nextInt();
        
        String numStr = Integer.toString(num); // convert to string
        int count = 0;

        for (int i = 0; i < numStr.length(); i++) {
            int digit = numStr.charAt(i) - '0'; // convert char to int
            if (digit != 0 && num % digit == 0) { 
                count++;
            }
        }

        System.out.println("Count of digits dividing " + num + " = " + count);
    }
}

