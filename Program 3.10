/* Program 3.10: Write a Java program to store multiple strings in an array and display them in alphabetical order, then find the 
longest string among them. */
// Program 3.10: Store multiple strings, sort alphabetically (manual), and find longest string
import java.util.Scanner;

public class Program310Manual {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        //Input number of strings
        System.out.print("Enter number of strings: ");
        int n = sc.nextInt();
        sc.nextLine(); // consume newline

        //Store strings in array
        String[] arr = new String[n];
        for (int i = 0; i < n; i++) {
            System.out.print("Enter string " + (i + 1) + ": ");
            arr[i] = sc.nextLine();
        }

        //bubble sort
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j].compareTo(arr[j + 1]) > 0) {
                    // swap
                    String temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }

        System.out.println("\nStrings in alphabetical order:");
        for (String s : arr) {
            System.out.println(s);
        }

        // longest string
        String longest = arr[0];
        for (int i = 1; i < n; i++) {
            if (arr[i].length() > longest.length()) {
                longest = arr[i];
            }
        }
        System.out.println("\nLongest string: " + longest);
    }
}
