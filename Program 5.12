/*  Program 5.12: Create a class “Animal” with a method “move()” that displays a message “The animal is moving”. 
Create two subclasses “Bird” and “Fish” that extend “Animal” and implement the “move()” method to display “The bird is flying” and “The fish is swimming” respectively.
*/
class Animal {
    void move() {
        System.out.println("The animal is moving");
    }
}

class Bird extends Animal {
    @Override
    void move() {
        System.out.println("The bird is flying");
    }
}

class Fish extends Animal {
    @Override
    void move() {
        System.out.println("The fish is swimming");
    }
}

public class Main {
    public static void main(String[] args) {
        // Object of Animal
        Animal a = new Animal();
        a.move();  // prints "The animal is moving"

        // Object of Bird
        Bird b = new Bird();
        b.move();  // prints "The bird is flying"

        // Object of Fish
        Fish f = new Fish();
        f.move();  // prints "The fish is swimming"
    }
}
