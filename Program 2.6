/* Program 2.6: Write a Java program that counts how many times each digit appears in a 
number. 
Example: 
Input: 1223401 
Output: 
1 → 2 times 
2 → 2 times 
3 → 1 time 
4 → 1 time 
0 → 1 time */
import java.util.Scanner;

public class DigitFrequency {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        String numStr = sc.nextLine();   // read as string

        int[] freq = new int[10]; // array for digits 0–9

        // Count frequencies
        for (int i = 0; i < numStr.length(); i++) {
            char ch = numStr.charAt(i);
            if (Character.isDigit(ch)) {
                int digit = ch - '0';
                freq[digit]++;
            }
        }

        // Print results
        for (int i = 0; i < 10; i++) {
            if (freq[i] > 0) {
                System.out.println(i + " → " + freq[i] + " times");
            }
        }
    }
}
