/*  Program 9.5: Assignment 5: Thread Priority Demonstration
Objective: Analyze priorities.
Task: Create five threads with priorities from 1 to 10. Each prints its name 10 times. 
Record execution over multiple runs and conclude whether higher priorities always execute first.
*/
public class ThreadPriorityDemo {
    // Custom thread class
    static class PriorityThread extends Thread {
        public PriorityThread(String name, int priority) {
            super(name);
            setPriority(priority);
        }

        @Override
        public void run() {
            for (int i = 1; i <= 10; i++) {
                System.out.println("Thread: " + getName() +
                                   " | Priority: " + getPriority() +
                                   " | Count: " + i);
            }
        }
    }

    public static void main(String[] args) {
        PriorityThread t1 = new PriorityThread("T1", 1);
        PriorityThread t2 = new PriorityThread("T2", 3);
        PriorityThread t3 = new PriorityThread("T3", 5);
        PriorityThread t4 = new PriorityThread("T4", 7);
        PriorityThread t5 = new PriorityThread("T5", 10);

        t1.start();
        t2.start();
        t3.start();
        t4.start();
        t5.start();
    }
}
